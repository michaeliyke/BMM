{
    "name": "Bookmark Manager",
    "version": "0.0.1",
    "manifest_version": 3,
    "description": "An extension to manage bookmarks",
    "author": "Michael C. Iyke, Dawit Getu, and Jumoke Kazeem",
    "icons": {
        "128": "/assets/img/icons/icon128.png",
        "48": "/assets/img/icons/icon48.ico",
        "16": "/assets/img/icons/icon16.png"
    },
    "background": {
        "service_worker": "/popup/background/sw.js",
        "type": "module"
    },
    "action": {
        "default_popup": "/popup/index.html",
        "default_icon": {
            "32": "/assets/img/icons/icon128.png",
            "24": "/assets/img/icons/icon48.ico",
            "16": "/assets/img/icons/icon16.png"
        },
        "default_title": "BookMark Manager"
    },
    "options_ui": {
        "page": "/assets/templates/options_ui.html",
        "open_in_tab": false
    },
    "permissions": [
        "bookmarks",
        "tabs",
        "storage",
        "activeTab",
        "scripting",
        "windows"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}
